<Window x:Class="TaskTray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskTray.ViewModels"
        Title="TaskTray Manager" Height="520" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        MinHeight="450" MinWidth="700">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local_converters:Base64ToImageConverter x:Key="Base64ToImageConverter" xmlns:local_converters="clr-namespace:TaskTray.Converters"/>

        <!-- App Item Template -->
        <DataTemplate x:Key="AppItemTemplate">
            <Border Background="{StaticResource SurfaceElevatedBrush}" 
                    CornerRadius="6" Margin="0,0,0,8" Padding="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Image Width="32" Height="32" Margin="0,0,12,0"
                           Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" 
                            Command="{Binding DataContext.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Padding="8,2" Background="Transparent" BorderThickness="0"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>   <!-- Main Content -->
            <RowDefinition Height="55"/> <!-- Action Bar -->
        </Grid.RowDefinitions>

        <!-- Zone 1: Toolbar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" HorizontalAlignment="Left" Tag="Search apps..."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <Button Content="+ Add Program" Command="{Binding AddProgramCommand}" Margin="0,0,8,0"/>
                    <Button Content="+" Command="{Binding AddCategoryCommand}" Width="40"/>
                </StackPanel>

                <Button Grid.Column="2" Content="⚙" Width="40" Padding="0"/>
            </Grid>
        </Border>

        <!-- Zone 2: Main Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Panel (Left) -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceBrush}">
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0" Margin="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource HeaderText}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Content Panel (Right) -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,15">
                    <ItemsControl ItemsSource="{Binding FilteredApps}"
                                 ItemTemplate="{StaticResource AppItemTemplate}"
                                 Visibility="{Binding HasApps, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding NoApps, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="60" Height="60" CornerRadius="30" 
                            Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,0,20">
                        <TextBlock Text="+" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="No apps here yet" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Add apps by dragging them here or using the '+' button above." 
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Width="300" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Zone 3: Action Bar (Bottom) -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,0" Background="{StaticResource SurfaceBrush}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Rename" Command="{Binding RenameCategoryCommand}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Remove" Command="{Binding DeleteCategoryCommand}" Width="80"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Import" Command="{Binding ImportCommand}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Export" Command="{Binding ExportCommand}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
