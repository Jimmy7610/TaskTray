<Window x:Class="TaskTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskTray.ViewModels"
        xmlns:loc="clr-namespace:TaskTray.Services"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Title="{loc:Loc SettingsTitle}">
    <Window.DataContext>
        <vm:SettingsViewModel/>
    </Window.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Settings}" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <CheckBox Content="{loc:Loc AutoStart}" 
                      IsChecked="{Binding IsAutoStartEnabled}" 
                      Margin="0,0,0,15"
                      Foreground="{StaticResource TextBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Language}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding Languages}" 
                          SelectedItem="{Binding SelectedLanguage}" 
                          Width="100"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}" 
                    Click="OnSaveClick" Width="80" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="{loc:Loc Cancel}" Click="OnCancelClick" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
